# --- データベース設定 ---
# Drizzle ORM が直接 PostgreSQL に接続するための URL
# Supabase Dashboard > Project Settings > Database > Connection string (Transaction Mode または Session Mode) から取得
DATABASE_URL=DATABASE_URL=postgres://postgres.xxxx:[パスワード]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres

# --- Supabase 設定 ---
# クライアントサイド (ブラウザ) で使用する公開キー
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# サーバーサイド (API Routes) で管理操作を行うための特権キー
# ⚠️ 公開しないでください
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Redis 設定 (Upstash) ---
# 統計データのキャッシングに使用します
UPSTASH_REDIS_REST_URL=your-upstash-redis-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token